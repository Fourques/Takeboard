{
  "name": "takeboard",
  "version": "0.2.0-beta.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.12 <27"
  },
  "scripts": {
    "easy": "node scripts/takeboard-easy.mjs start",
    "easy:setup": "node scripts/takeboard-easy.mjs setup",
    "easy:stop": "node scripts/takeboard-easy.mjs stop",
    "easy:doctor": "node scripts/takeboard-easy.mjs doctor",
    "easy:remote": "node scripts/takeboard-easy.mjs remote",
    "easy:restore": "node scripts/takeboard-easy.mjs restore",
    "dev": "pnpm --parallel --filter @takeboard/server --filter @takeboard/web dev",
    "dev:web": "pnpm --filter @takeboard/web dev",
    "dev:server": "pnpm --filter @takeboard/server dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm -r --if-present test && node --test scripts/*.test.mjs",
    "test:e2e": "pnpm build && playwright test",
    "gate:release": "pnpm verify && pnpm test:e2e",
    "gate:gpu": "node scripts/gpu-release-gate.mjs",
    "compatibility:matrix": "node scripts/build-compatibility-matrix.mjs",
    "demo:capture": "pnpm build && node scripts/capture-product-demo.mjs",
    "desktop:prepare": "pnpm --filter @takeboard/desktop prepare-runtime",
    "desktop:check": "pnpm --filter @takeboard/desktop check",
    "desktop:bundle": "pnpm --filter @takeboard/desktop bundle",
    "bundle:portable": "node scripts/build-portable-bundle.mjs",
    "bundle:verify": "node scripts/verify-release-checksums.mjs release",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm compatibility:matrix -- --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@biomejs/biome": "2.5.8",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
