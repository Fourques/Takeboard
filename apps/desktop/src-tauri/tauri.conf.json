{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TakeBoard",
  "version": "0.2.0-beta.1",
  "identifier": "app.takeboard.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TakeBoard",
        "url": "index.html",
        "width": 1440,
        "height": 900,
        "minWidth": 920,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "Copyright © TakeBoard contributors",
    "shortDescription": "Local-first AI filmmaking workspace",
    "longDescription": "Organize assets, shots, ComfyUI workflows, generation runs and approved takes in one local-first workspace.",
    "resources": ["resources/TakeBoard/**"],
    "externalBin": ["binaries/takeboard-node"]
  }
}
