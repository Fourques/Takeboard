# TakeBoard reads this file through the user-level systemd service.
# Keep secrets out of this file unless its permissions remain 0600.

COMFY_URL=http://127.0.0.1:8188
COMFY_EDITOR_URL=http://127.0.0.1:48188

# Optional: configure both paths to enable precise cleanup of files created by a run.
COMFY_INPUT_ROOT=
COMFY_OUTPUT_ROOT=

# Optional safe-start provider. Keep `auto` to use the native provider for the host OS.
COMFY_LAUNCH_PROVIDER=auto
COMFY_START_SERVICE=takeboard-comfy.service
COMFY_LAUNCHD_LABEL=
COMFY_WINDOWS_SERVICE=

# Portable process mode. The executable must be absolute; arguments are a JSON string array.
COMFY_START_EXECUTABLE=
COMFY_START_ARGS_JSON=[]
COMFY_START_CWD=
COMFY_START_PID_FILE=

# Resource safeguards checked before TakeBoard starts ComfyUI.
COMFY_ACCELERATOR=auto
COMFY_GPU_INDEX=0
COMFY_MIN_FREE_RAM_GB=6
COMFY_MIN_FREE_VRAM_GB=4
COMFY_MAX_GPU_UTILIZATION=85

# Disk reserves checked before any generation input is uploaded or queued.
TAKEBOARD_MIN_FREE_DISK_GB=5
COMFY_MIN_FREE_OUTPUT_DISK_GB=8

# Authentication is required by default. `off` and `trusted_local` are only for an
# isolated loopback machine; they can never be combined with a non-loopback bind.
TAKEBOARD_AUTH_MODE=required
# TAKEBOARD_AUTH_DATABASE=/absolute/path/to/TakeBoardData/.system/auth.db
# Optional human-readable name shown in Access & Devices.
# TAKEBOARD_INSTANCE_NAME=Studio GPU

# Optional full-instance backup loop. The destination must be outside
# TAKEBOARD_DATA_ROOT; use an external disk, mounted NAS, or backup volume.
# TAKEBOARD_BACKUP_DESTINATION=/mnt/studio-backups/takeboard
TAKEBOARD_BACKUP_INTERVAL_HOURS=24
TAKEBOARD_BACKUP_KEEP_LOCAL=2
TAKEBOARD_BACKUP_KEEP_DAILY=7
TAKEBOARD_BACKUP_KEEP_WEEKLY=4
TAKEBOARD_BACKUP_KEEP_MONTHLY=6
TAKEBOARD_BACKUP_DRILL_INTERVAL_DAYS=30

# Keep loopback + SSH tunnelling for the simplest safe setup. For a team HTTPS
# reverse proxy, configure all four settings below and keep ComfyUI private.
# TAKEBOARD_ALLOW_NON_LOOPBACK=1
# TAKEBOARD_ALLOWED_HOSTS=studio.example.com
# TAKEBOARD_ALLOWED_ORIGINS=https://studio.example.com
# TAKEBOARD_SECURE_COOKIES=1
# TAKEBOARD_PUBLIC_URL=https://studio.example.com

# Maximum expanded project-package upload size in bytes (default: 1 TiB).
# TAKEBOARD_PROJECT_PACKAGE_MAX_BYTES=1099511627776
