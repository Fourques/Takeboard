# Copy to .env, replace example.com and generate the two secrets locally.
TAKEBOARD_PORTAL_HOSTNAME=portal.example.com
TAKEBOARD_PORTAL_ORIGIN=https://portal.example.com
TAKEBOARD_PORTAL_SECURE_COOKIES=1
TAKEBOARD_PORTAL_ALLOW_REGISTRATION=0
TAKEBOARD_PORTAL_AUDIT_RETENTION_DAYS=180
TAKEBOARD_PORTAL_BOOTSTRAP_TOKEN=replace-with-openssl-rand-base64-36
# Optional: inject a stable 32-byte base64url key from a secret manager instead of the generated .key file.
# TAKEBOARD_PORTAL_MASTER_KEY=
