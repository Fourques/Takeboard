#!/usr/bin/env bash
set -euo pipefail

app_port=${TAKEBOARD_PORT:-48120}
https_port=${TAKEBOARD_TAILSCALE_HTTPS_PORT:-443}
health_url="http://127.0.0.1:${app_port}/api/health"

usage() {
  cat <<'EOF'
TakeBoard private tailnet access

Usage: ./scripts/takeboard-share <command>

Commands:
  enable    Publish TakeBoard privately through Tailscale Serve HTTPS
  status    Show the active Serve configuration
  disable   Remove only TakeBoard's HTTPS Serve listener
  url       Print this node's stable tailnet HTTPS URL

This script uses Tailscale Serve, not Funnel. It does not expose TakeBoard
to the public internet. Tailnet ACLs still determine who may connect.
EOF
}

require_tailscale() {
  if ! command -v tailscale >/dev/null 2>&1; then
    echo "tailscale is not installed." >&2
    exit 1
  fi
  if ! tailscale status >/dev/null 2>&1; then
    echo "tailscale is installed but not connected." >&2
    exit 1
  fi
}

tailnet_url() {
  local dns_name
  dns_name=$(tailscale status --json | jq -r '.Self.DNSName // empty' | sed 's/\.$//')
  if [[ -z $dns_name ]]; then
    echo "Unable to determine this device's Tailscale DNS name." >&2
    return 1
  fi
  if [[ $https_port == 443 ]]; then
    echo "https://${dns_name}"
  else
    echo "https://${dns_name}:${https_port}"
  fi
}

require_jq() {
  if ! command -v jq >/dev/null 2>&1; then
    echo "jq is required to print the stable tailnet URL." >&2
    exit 1
  fi
}

command_name=${1:-help}
case "$command_name" in
  enable)
    require_tailscale
    require_jq
    if ! curl --fail --silent --max-time 5 "$health_url" >/dev/null; then
      echo "TakeBoard is not healthy at ${health_url}. Start it first:" >&2
      echo "  ./scripts/takeboard start" >&2
      exit 1
    fi
    tailscale serve --bg --yes --https="$https_port" "http://127.0.0.1:${app_port}"
    echo
    echo "TakeBoard is available inside your tailnet:"
    tailnet_url
    ;;
  status)
    require_tailscale
    tailscale serve status
    ;;
  disable)
    require_tailscale
    tailscale serve --https="$https_port" off
    echo "TakeBoard tailnet HTTPS access disabled."
    ;;
  url)
    require_tailscale
    require_jq
    tailnet_url
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: ${command_name}" >&2
    usage >&2
    exit 2
    ;;
esac
